{
  "name": "vite-plugin-hyperframes-jsx",
  "version": "0.1.0",
  "description": "Build-once JSX for HyperFrames compositions, as a Vite plugin and a tiny DOM runtime",
  "keywords": [
    "animation",
    "gsap",
    "hyperframes",
    "jsx",
    "video",
    "vite",
    "vite-plugin"
  ],
  "homepage": "https://github.com/inurun/vite-plugin-hyperframes-jsx#readme",
  "bugs": "https://github.com/inurun/vite-plugin-hyperframes-jsx/issues",
  "license": "MIT",
  "author": "inurun",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/inurun/vite-plugin-hyperframes-jsx.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "default": "./dist/runtime.js"
    },
    "./jsx-runtime": {
      "types": "./dist/jsx-runtime.d.ts",
      "default": "./dist/jsx-runtime.js"
    },
    "./jsx-dev-runtime": {
      "types": "./dist/jsx-dev-runtime.d.ts",
      "default": "./dist/jsx-dev-runtime.js"
    },
    "./static-file": {
      "types": "./dist/static-file.d.ts",
      "default": "./dist/static-file.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "tsc": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "pnpm build && pnpm test"
  },
  "dependencies": {
    "gsap": "^3.15.0"
  },
  "devDependencies": {
    "@types/node": "25.9.3",
    "happy-dom": "20.11.2",
    "oxfmt": "0.55.0",
    "oxlint": "1.70.0",
    "tsdown": "0.23.0",
    "typescript": "6.0.3",
    "vite": "8.0.16",
    "vitest": "4.1.9"
  },
  "peerDependencies": {
    "vite": ">=8"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
